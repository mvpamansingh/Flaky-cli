{
  "name": "flaky-test-detective",
  "version": "0.1.0",
  "description": "Framework-agnostic CLI that detects flaky tests by running an existing test suite N times and correlating results.",
  "keywords": [
    "flaky",
    "flaky-tests",
    "flakiness",
    "nondeterministic",
    "test-reliability",
    "junit",
    "test-runner",
    "ci",
    "cli",
    "vitest",
    "jest",
    "pytest"
  ],
  "homepage": "https://github.com/mvpamansingh/Flaky-cli#readme",
  "bugs": {
    "url": "https://github.com/mvpamansingh/Flaky-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mvpamansingh/Flaky-cli.git"
  },
  "author": "Aman Singh",
  "type": "module",
  "license": "MIT",
  "bin": {
    "flaky": "./dist/cli.js"
  },
  "files": ["dist"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/cli.js",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "boxen": "^8.0.1",
    "chalk": "^5.4.1",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "execa": "^9.6.1",
    "fast-xml-parser": "^5.10.1",
    "figlet": "^1.8.0",
    "gradient-string": "^3.0.0",
    "ora": "^9.4.1",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "puppeteer": ">=22"
  },
  "peerDependenciesMeta": {
    "puppeteer": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/figlet": "^1.7.0",
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^3.0.2"
  }
}
